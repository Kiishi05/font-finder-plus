{
  "name": "font-finder-plus",
  "version": "0.1.0",
  "private": true,
  "description": "Identify, understand, swap and export the fonts on any website.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "FFP_TEST=1 node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "build:catalog": "node scripts/build-gf-catalog.mjs",
    "test": "node tests/run.mjs",
    "build:shapes": "node scripts/build-gf-shapes.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.5",
    "dexie": "4.0.11",
    "dexie-react-hooks": "1.1.7",
    "fontkit": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "6.3.5"
  }
}
